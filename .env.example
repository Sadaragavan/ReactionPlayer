# ---------------------------------------------------------------------------
# ReactionPlayer environment
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# No production credentials are invented or shipped in this repository.
# See docs/ENVIRONMENT.md for the full setup guide.
# ---------------------------------------------------------------------------

# --- Database (required for pass metering, consent, entitlements) -------------
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the connection POOLER string for serverless/many-instance deployments.
# Local development: run `npm run db:setup:dev`, which prints a ready-to-paste URL.
DATABASE_URL=

# --- Supabase Auth (production auth provider) --------------------------------
# Project Settings -> API. The anon key is public by design and safe in the browser;
# row-level security is what protects data.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS. Never expose to the browser, never prefix with PUBLIC_.
# Only needed for trusted operations (audit appends, bonus grants, webhooks).
SUPABASE_SERVICE_ROLE_KEY=

# --- Development-only auth provider -----------------------------------------
# Enables a local, server-side account system so the app runs without Supabase.
# REFUSES to activate when NODE_ENV=production. Never enable in a deployed environment.
ALLOW_DEV_AUTH=false

# Port for the local development PostgreSQL cluster started by `npm run db:setup:dev`.
DEV_DB_PORT=55432

# --- Deployment -------------------------------------------------------------
# Absolute origin of the deployed app, used for CSRF/redirect correctness.
# Example: https://reactionplayer.example.com
ORIGIN=

# Set by the hosting platform. `production` disables development affordances.
NODE_ENV=development

# --- Stripe (monetization phase; NOT implemented in v0.0) --------------------
# Present as placeholders so the boundary is documented. Billing is feature-flagged off.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Development-only: scale rate-limit capacity so automated suites that create many
# accounts from one IP are not throttled. Defaults to 1 (real limits).
# REFUSED when NODE_ENV=production, regardless of the value set here.
# ---------------------------------------------------------------------------
# RATE_LIMIT_MULTIPLIER=100
