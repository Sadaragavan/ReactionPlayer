{
	"name": "reactionplayer",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Synchronized reaction-video playback. The application does not host, redistribute, or bypass access controls for media.",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:migrate": "node --experimental-strip-types scripts/migrate.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:setup:dev": "node --experimental-strip-types scripts/dev-db.ts",
		"grant:owner": "node --experimental-strip-types scripts/grant-owner.ts",
		"verify:slice": "node --experimental-strip-types scripts/verify-slice.ts"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.15",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^22.19.1",
		"embedded-postgres": "^18.6.0-beta.19",
		"eslint": "^9.39.1",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^7.3.7",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@lucide/svelte": "^1.68.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"idb": "^8.0.4",
		"postgres": "^3.4.9"
	}
}
